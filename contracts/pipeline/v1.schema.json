{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kionga.dev/schemas/pipeline/v1.json",
  "title": "Kionga pipeline definition (kionga.dev/v1 Pipeline)",
  "description": "Structural schema for editors. The control plane also enforces graph rules a schema cannot express: unique node ids, existing dependencies, no cycles, valid cron and IANA timezone, and that overridable parameters are declared.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "kionga.dev/v1"},
    "kind": {"const": "Pipeline"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "project", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "project": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes"],
      "properties": {
        "executionMode": {"enum": ["prefect", "functions"], "default": "prefect"},
        "parameters": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"}},
        "overridable": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parameters": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "image": {"type": "boolean"},
            "resources": {"type": "boolean"},
            "retries": {"type": "boolean"},
            "timeout": {"type": "boolean"},
            "nodes": {"type": "boolean"},
            "parallelism": {"type": "boolean"}
          }
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": {"enum": ["manual", "schedule", "api", "event"]},
              "cron": {"type": "string", "pattern": "^\\S+(\\s+\\S+){4}$"},
              "timezone": {"type": "string"},
              "paused": {"type": "boolean"},
              "topic": {"type": "string"}
            },
            "allOf": [
              {"if": {"properties": {"type": {"const": "schedule"}}}, "then": {"required": ["cron"]}},
              {"if": {"properties": {"type": {"const": "event"}}}, "then": {"required": ["topic"]}}
            ]
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"repository": {"type": "string"}, "commit": {"type": "string"}}
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"},
              "type": {"enum": ["container", "function"]},
              "description": {"type": "string"},
              "image": {"type": "string", "minLength": 1},
              "function": {"type": "string", "minLength": 1},
              "command": {"type": "array", "items": {"type": "string"}},
              "dependsOn": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "inputs": {"type": "array", "items": {"type": "string"}},
              "outputs": {"type": "array", "items": {"type": "string"}},
              "env": {"type": "object", "additionalProperties": {"type": "string"}},
              "resourceProfile": {"type": "string"},
              "resources": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cpu": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?m?$"},
                  "memory": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti)?$"},
                  "gpu": {"type": "integer", "minimum": 0}
                }
              },
              "retry": {
                "type": "object",
                "additionalProperties": false,
                "required": ["max"],
                "properties": {
                  "max": {"type": "integer", "minimum": 0, "maximum": 10},
                  "backoffSeconds": {"type": "integer", "minimum": 0, "maximum": 3600}
                }
              },
              "timeoutSeconds": {"type": "integer", "minimum": 0, "maximum": 86400},
              "when": {
                "type": "object",
                "additionalProperties": false,
                "required": ["param", "equals"],
                "properties": {"param": {"type": "string"}, "equals": {"type": "string"}}
              }
            },
            "allOf": [
              {"if": {"properties": {"type": {"const": "container"}}}, "then": {"required": ["image"]}},
              {"if": {"properties": {"type": {"const": "function"}}}, "then": {"required": ["function"]}}
            ]
          }
        }
      }
    }
  }
}
