{
  "name": "kionga-console-tests",
  "private": true,
  "scripts": {
    "test:ui": "npm test --prefix frontend && node --test tests/ui/vendor-integrity.test.cjs",
    "test:e2e": "playwright test",
    "build:frontend": "npm ci --prefix frontend --ignore-scripts && npm run build --prefix frontend",
    "type-check": "npm run type-check --prefix frontend",
    "test:core": "playwright test --config playwright.core.config.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.0",
    "jsdom": "26.1.0"
  }
}
