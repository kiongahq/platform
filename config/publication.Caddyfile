# Optional public read-only host for a publication's API and media. The
# install serves no blog pages; the Kionga website (or an adopter's own site)
# renders articles from these endpoints. Set the publication domain and the
# upstream installation that owns this publication's editorial data.
{$KIONGA_PUBLICATION_DOMAIN} {
    encode gzip
    @reading {
        method GET HEAD
        path /api/v1/blogs /api/v1/blogs/* /media/blog/*
    }
    handle @reading {
        reverse_proxy {$KIONGA_PUBLICATION_UPSTREAM}
    }
    handle {
        respond 404
    }
}
